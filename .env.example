APP_ENV=local
APP_DEBUG=true

APP_URL=http://localhost/stockex
BASE_URL=http://localhost/stockex/

# Public URL of the client self-service page (client-update.html).
# Links minted via the portal API will point to this subdomain.
CLIENT_PORTAL_URL=https://clients.vfsl.co.tz/
# Additional origins allowed to call the portal API (comma-separated).
# e.g. https://client.vfsl.co.tz,https://clients.vfsl.co.tz
PORTAL_ALLOWED_ORIGINS=https://client.vfsl.co.tz,https://clients.vfsl.co.tz

# Name match minimum percentage for form submissions (default 60).
PORTAL_NAME_MATCH_MIN=60

# Cloudflare Turnstile CAPTCHA
# Site key goes in the frontend HTML (index.html data-sitekey attribute).
# Secret key is verified server-side here.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

DB_HOST=localhost
DB_NAME=stockex_local_db
DB_USERNAME=root
DB_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=StockEx Mailer
SMTP_VERIFY_PEER=false
SMTP_DEBUG=1

# Debug Page Security (email_debug.php)
DEBUG_ACCESS_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
DEBUG_ALLOWED_IPS=127.0.0.1,::1
DEBUG_MAX_ATTEMPTS=5
