APP_ENV=local
APP_DEBUG=true

APP_URL=http://localhost/stockex
BASE_URL=http://localhost/stockex/

# Public URL of the client self-service page (client-update.html).
# Links minted via the portal API will point to this subdomain.
CLIENT_PORTAL_URL=https://clients.vfsl.co.tz/

# SMS gateway (JSON API, /sendsms_api_json.aspx).
# SMS_MODE=log prints messages to the error log instead of dialing out (dev).
SMS_API_URL=
SMS_USER=
SMS_PWD=
SMS_SENDER=
SMS_LANGUAGE=English
SMS_MODE=log

# SMS OTP flow limits (per number/account, controls cost + abuse).
SMS_COOLDOWN_SEC=60
SMS_MAX_PER_NUMBER_HOUR=3
SMS_MAX_PER_NUMBER_DAY=5
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=3

DB_HOST=localhost
DB_NAME=stockex_local_db
DB_USERNAME=root
DB_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=StockEx Mailer
SMTP_VERIFY_PEER=false
SMTP_DEBUG=1

# Debug Page Security (email_debug.php)
DEBUG_ACCESS_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
DEBUG_ALLOWED_IPS=127.0.0.1,::1
DEBUG_MAX_ATTEMPTS=5
